# Copy to .env and fill in. Never commit .env; it is git-ignored.
#
# Only APP_ENV, DEPLOYMENT_KEY, APP_BASE_URL, SECRET_KEY, and DATABASE_URL are read
# by the application today. The remaining variables are declared so their names are
# settled before the integrations that use them are built; leave them blank.
#
# Staging and production refuse to start without SECRET_KEY, DATABASE_URL,
# DEPLOYMENT_KEY, and an https APP_BASE_URL.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------

# development | test | staging | production
APP_ENV=development

# Selects which deployment configuration applies. Configuration data, never a value
# that domain logic branches on.
DEPLOYMENT_KEY=cts

APP_BASE_URL=http://127.0.0.1:5000

# Signs sessions. Leave blank in development and a random per-process key is
# generated, which invalidates sessions on restart. Required, at least 32 characters,
# in staging and production. Generate one with:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# Matches infra/containers/docker-compose.yml. Development-only credentials.
#
# Use 127.0.0.1 rather than localhost. The container publishes on IPv4 loopback only,
# and on Windows 'localhost' resolves to ::1 first, which stalls for roughly two
# minutes per connection before falling back.
DATABASE_URL=postgresql://platform:platform@127.0.0.1:5432/platform

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------

# CRITICAL | ERROR | WARNING | INFO | DEBUG
LOG_LEVEL=INFO
# console | json. Defaults to console locally and json when deployed.
LOG_FORMAT=

# ---------------------------------------------------------------------------
# Not yet implemented. Declared for naming stability only; leave blank.
# ---------------------------------------------------------------------------

OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
MATRIX_HOMESERVER_URL=
MATRIX_SERVICE_CREDENTIAL=
CHATGPT_DRAFT_RECEIVER_SECRET=
