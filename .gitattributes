# Normalise line endings in the repository to LF.
#
# .editorconfig already asks editors for LF. Without this file, Git's autocrlf
# setting on a Windows machine checks files out as CRLF and can commit them back
# that way, which produces whole-file diffs that hide the real change.
#
# Working copies still get whatever the developer's Git is configured to use; only
# what is stored in the repository is normalised.

* text=auto eol=lf

# Generated by uv. Diffing it is noise, and merging it by hand is a mistake: rerun
# 'uv lock' instead.
uv.lock linguist-generated=true merge=binary

# Always binary, so Git never attempts line-ending conversion on them.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.zip binary
